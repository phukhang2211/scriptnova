# Copy this file to `.env`. Everything below has a sensible default for
# running locally on Windows — you don't need to fill in anything to get
# started. Your AssemblyAI key can be entered later from the Settings page
# in the app itself instead of here.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Optional — you can also paste this into the in-app Settings page instead.
ASSEMBLYAI_API_KEY=

# Optional: set to a public URL for instant async completion via webhook.
# Leave blank — the default (blocking) path works fine for local use.
ASSEMBLYAI_WEBHOOK_URL=
ASSEMBLYAI_WEBHOOK_TOKEN=

# ── Uploads ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_FILE_SIZE_MB=1024
ALLOWED_UPLOAD_EXTENSIONS=.mp3,.wav,.m4a,.mp4,.mov,.webm,.aac
UPLOADS_PER_MINUTE_LIMIT=10

# ── Email (optional) ─────────────────────────────────────────────────────────
# Default prints emails to the terminal instead of sending them. To send real
# "your transcript is ready" emails, configure SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost
